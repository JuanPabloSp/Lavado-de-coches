{
  "name": "lavadero",
  "version": "0.1.0",
  "description": "Gestión de un lavadero de autos: plazas de trabajo, lista de espera y cobro. Local, un solo dispositivo.",
  "private": true,
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/index.js",
    "demo": "node server/scripts/demo.js",
    "test": "jest --runInBand"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.2.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  }
}
